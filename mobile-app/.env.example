# Copiar a .env.local para desarrollo, o cargar como Environment Variables en Vercel.

# Qué motor de IA orquesta el tool calling. "gemini" (default) es gratis, sin
# tarjeta de crédito. "anthropic" requiere una API key de pago.
AI_PROVIDER=gemini

# --- Gemini (gratis, recomendado para la demo en Vercel) ---
# Conseguir una key gratis, sin tarjeta, en https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# --- Anthropic (de pago, opcional) ---
# https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Modo autocontenido (recomendado): la propia app llama a la API del motor
# elegido desde app/api/voice/route.ts, sin necesitar el backend/ desplegado
# en otro lado.
#
# Opcional: si en cambio querés que el simulador hable con tu backend/ real
# (por ejemplo corriendo en tu PC/servidor, expuesto con ngrok/tunnel), seteá
# esto y la app ignora su propia API route y pega contra ese backend.
# NEXT_PUBLIC_BACKEND_URL=https://tu-backend-expuesto.example.com
