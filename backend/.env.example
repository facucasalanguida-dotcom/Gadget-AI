# Copiar a .env y completar.

# Qué motor de IA orquesta el tool calling. "gemini" (default) es gratis, sin
# tarjeta de crédito. "anthropic" requiere una API key de pago.
AI_PROVIDER=gemini

# --- Gemini (gratis) ---
# Conseguir una key gratis en https://aistudio.google.com/apikey (sin tarjeta).
GEMINI_API_KEY=
# Alias estable que Google mantiene apuntando al modelo Flash vigente.
GEMINI_MODEL=gemini-flash-latest

# --- Anthropic (de pago, opcional) ---
# https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Puerto HTTP/WS del backend (el ESP32 y mobile-app apuntan a este puerto)
PORT=8787

# --- Polling de Fase 2 (alertas proactivas) ---
# Opcional: si no se completa POLLING_ASSET_ID, el polling queda desactivado
# y el resto del backend funciona normal. Fuente: CoinGecko (gratis, sin key).
# ID del activo según CoinGecko, ej. "bitcoin", "ethereum"
# (lista completa: https://api.coingecko.com/api/v3/coins/list)
POLLING_ASSET_ID=
# Moneda de referencia (default: usd)
POLLING_CURRENCY=usd
# Umbrales — completar al menos uno. Se dispara una alerta (push por
# WebSocket a los dispositivos conectados) al cruzar el umbral, no en cada
# poll mientras se mantenga cruzado.
POLLING_ALERT_ABOVE=
POLLING_ALERT_BELOW=
# Cada cuánto consultar la fuente, en ms (default: 60000 = 1 min)
POLLING_INTERVAL_MS=60000
